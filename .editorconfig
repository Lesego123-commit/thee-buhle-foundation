root = true

# -----------------------------------------------------------------------------
#  Shared editor and analyser settings.
# -----------------------------------------------------------------------------

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
max_line_length = 120

[*.{json,yml,yaml,csproj,props,slnx}]
indent_size = 2

[*.{js,ts,tsx,css,html}]
indent_size = 2

# -----------------------------------------------------------------------------
#  EF Core migrations.
#
#  Generated by `dotnet ef`, not written by hand. TreatWarningsAsErrors is on
#  for the whole solution, which is what we want for our own code — but it also
#  means an analyser opinion about a file the tool writes can fail the build,
#  and the only way to satisfy it is to hand-edit generated code that the next
#  `migrations add` will overwrite.
#
#  So analysis is off here and only here. The migration's correctness is
#  established by applying it to a real database in the integration suite, which
#  is a better check than any style rule.
# -----------------------------------------------------------------------------

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.IDE0161.severity = none

# -----------------------------------------------------------------------------
#  Tests.
#
#  Two rules are relaxed here and only here.
#
#  CA1707 forbids underscores in member names, which is right for library code
#  and wrong for tests. `A_link_signed_for_one_user_does_not_verify_for_another`
#  reads as a sentence in a test runner's output; the PascalCase version of the
#  same name does not. The name IS the specification, so readability wins.
#
#  CA1861 objects to inline arrays in repeated calls, which is what a [Theory]
#  data row is.
# -----------------------------------------------------------------------------

[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
