@page "/news/{slug}"
@model ArticleModel
@{
    var post = Model.Post;
}

<article>
    <header class="banner">
        <p class="crumb">
            <a href="/">Home</a> › <a href="/news">News</a> ›
            <a href="/news?category=@NewsModel.SlugFor(post.Category)">
                @NewsModel.LabelFor(post.Category)
            </a>
        </p>
        <h1 class="d2" style="max-width:26ch">@post.Title</h1>
        <p class="lede">@post.Excerpt</p>
        <p class="row" style="gap:10px;margin-top:22px;font-size:12px;color:rgba(255,255,255,.75)">
            <span>@post.AuthorName</span> ·
            <time datetime="@post.PublishedAt.ToString("yyyy-MM-dd")">
                @post.PublishedAt.ToString("d MMMM yyyy")
            </time> ·
            <span>@post.ReadMinutes min read</span>
        </p>
    </header>

    <div class="band band--white">
        <div class="ph" style="height:380px;background:linear-gradient(150deg,#2E4034,#8B7A55);margin-bottom:48px">Photo · Article</div>

        @*
            Html.Raw is used exactly once on the whole site, here, and it is
            safe only because of where the sanitising happens: the body was put
            through HtmlSanitiser's allow-list on write, before it was ever
            stored. Sanitising on write means the column cannot hold a payload
            at all, so this template cannot become a vulnerability later by
            forgetting to escape something.

            Html.Raw( is deliberately grep-able for that reason.
        *@
        <div class="prose" style="max-width:68ch;font-size:17px;line-height:1.8">
            @Html.Raw(post.BodyHtml)
        </div>

        <div class="row" style="margin-top:48px;padding-top:32px;border-top:1px solid var(--line)">
            <a class="btn btn--ghost" href="/news">&larr; All articles</a>
            <a class="btn btn--forest spread" href="/donate">Support this work</a>
        </div>
    </div>
</article>
