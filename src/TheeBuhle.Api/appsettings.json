// =============================================================================
//  Non-secret configuration only.
//
//  Every value in this file is safe to commit. The secrets that go with it —
//  the database password, the JWT signing key, the HMAC signing key, the SMTP
//  password and the PayFast merchant key and passphrase — are NOT here and
//  never should be. They come from:
//
//    * production:  Azure App Service application settings and connection
//                   strings, set in the portal or by the deploy workflow from
//                   GitHub repository secrets.
//    * locally:     dotnet user-secrets, which lives outside the repository.
//
//  The double-underscore form maps a nested key onto an environment variable,
//  so Jwt__SigningKey overrides Jwt:SigningKey. That is how the Azure settings
//  reach these sections without this file ever holding a real value.
//
//  Note on the comments: .NET's JSON configuration provider skips real // and
//  /* */ comments. It does NOT ignore unknown keys in every section — the
//  logging section in particular binds each key as a log level, so a "//" key
//  used as a pseudo-comment there makes the host fail to start. Real comments,
//  not fake keys.
// =============================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // EF's command logging prints every SQL statement with its parameters,
      // which for a login means the email address. Warning, so a query only
      // appears when something is wrong with it.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "AllowedHosts": "*",

  // Set as an Azure App Service connection string named TheeBuhle, or locally:
  //   dotnet user-secrets set "ConnectionStrings:TheeBuhle" "..."
  "ConnectionStrings": {},

  "Jwt": {
    "Issuer": "https://theebuhlefoundation.co.za",
    "Audience": "theebuhle-clients"

    // SigningKey comes from configuration. At least 32 bytes, validated at
    // startup so a short key stops the deployment rather than failing on the
    // first login attempt in production.
  },

  "Signing": {
    // SigningKey comes from configuration, and is deliberately a DIFFERENT key
    // from the JWT's: a leaked download key must not let anybody forge a
    // consent record or a session.
    "DownloadLifetime": "00:15:00"
  },

  // Short access token because it cannot be revoked once issued; long refresh
  // token because it can be, instantly.
  "Auth": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "LockThreshold": 5,
    "LockMinutes": 15
  },

  // The domain's OWN mail server, not a third-party relay. The DNS already
  // publishes SPF and DKIM records authorising it, so mail sent through it
  // passes DMARC without touching DNS — which matters most for the two
  // messages that must not be filtered: a Section 18A tax certificate and a
  // safeguarding notice.
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "FromAddress": "noreply@theebuhlefoundation.co.za",
    "FromName": "Thee Buhle Foundation",
    "Timeout": "00:00:15"
  },

  // MerchantKey and Passphrase come from configuration. The passphrase is what
  // makes a callback signature unforgeable, so leaking it is leaking the
  // ability to mint donations.
  "PayFast": {
    "MerchantId": "",
    "ReturnUrl": "https://theebuhlefoundation.co.za/api/payments/return",
    "CancelUrl": "https://theebuhlefoundation.co.za/api/payments/cancel",
    "NotifyUrl": "https://theebuhlefoundation.co.za/api/payments/callback",
    "UseSandbox": true
  },

  // The foundation's real registration numbers. Configuration rather than
  // constants because they get corrected, and a wrong one lands on a donor's
  // tax return.
  "Safeguarding": {
    // The foundation's own safeguarding line, as it should be shown, e.g.
    // "+27 16 000 0000". Empty until the foundation gives us a real number:
    // the pages then show only Childline South Africa (116), because a
    // placeholder number on a child-safety page is a number someone might
    // call in an emergency.
    "Phone": ""
  },

  "Section18A": {
    "PboNumber": "",
    "NpoNumber": "",
    "PostalAddress": "Thee Buhle Foundation · Cornwallis Street S.E.7, Vanderbijlpark, Gauteng, 1911",
    "Threshold": 100
  },

  // SafeguardingAddress is the designated lead's own mailbox and must NOT be a
  // shared inbox — a child-safety report landing somewhere four people read is
  // the failure this routing exists to prevent.
  "Engagement": {
    "EnquiriesAddress": "hello@theebuhlefoundation.co.za",
    "SafeguardingAddress": "safeguarding@theebuhlefoundation.co.za",
    "PublicPhone": "+27 71 000 0000",
    "SafeguardingPhone": "+27 71 000 0001"
  },

  // Named origins only. An API that serves a known website and a known app has
  // no reason to answer a page it has never heard of.
  "Cors": {
    "Origins": [
      "https://theebuhlefoundation.co.za",
      "https://www.theebuhlefoundation.co.za"
    ]
  }
}
