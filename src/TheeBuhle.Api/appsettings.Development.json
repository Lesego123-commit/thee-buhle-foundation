// =============================================================================
//  Local development overrides.
//
//  The keys below are DEVELOPMENT-ONLY placeholders and are committed
//  deliberately, so that `dotnet run` and the integration tests work on a fresh
//  clone without anybody having to be handed a secret. They are long enough to
//  pass the startup validation and they sign nothing that matters.
//
//  They are NOT the production keys and must never be used as such. Production
//  reads its own values from Azure App Service application settings, which
//  override these; there is no code path in which these keys reach a deployed
//  environment, because this file is only loaded when ASPNETCORE_ENVIRONMENT is
//  Development.
//
//  The database connection string is deliberately absent even here. Set it with
//  user-secrets so a developer's own SQL Server credentials never end up in the
//  repository:
//
//    dotnet user-secrets set "ConnectionStrings:TheeBuhle" \
//      "Server=localhost;Database=TheeBuhleDev;Trusted_Connection=True;TrustServerCertificate=True" \
//      --project src/TheeBuhle.Api
// =============================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",

      // On in development, because seeing the generated SQL is how an
      // accidental client-side evaluation or an N+1 gets noticed before it
      // ships.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "Jwt": {
    "Issuer": "https://localhost:7191",
    "Audience": "theebuhle-clients-dev",
    "SigningKey": "development-only-signing-key-not-for-production-use-at-all"
  },

  "Signing": {
    "SigningKey": "development-only-hmac-key-different-from-the-jwt-one-on-purpose"
  },

  // PayFast's published sandbox credentials. Public, documented by PayFast, and
  // useless against a real merchant account.
  "PayFast": {
    "MerchantId": "10000100",
    "MerchantKey": "46f0cd694581a",
    "Passphrase": "jt7NOE43FZPn",
    "ReturnUrl": "https://localhost:7191/api/payments/return",
    "CancelUrl": "https://localhost:7191/api/payments/cancel",
    "NotifyUrl": "https://localhost:7191/api/payments/callback",
    "UseSandbox": true
  },

  // Placeholders. A certificate generated in development carries these and is
  // obviously not a real one.
  "Section18A": {
    "PboNumber": "PBO-000-000-000-DEV",
    "NpoNumber": "000-000-NPO-DEV"
  },

  // Smtp is deliberately left at its empty defaults from appsettings.json.
  // MailKitEmailSender then reports IsEnabled false, the email channel says it
  // cannot reach anybody, and the resolver falls back to in-app — so nothing
  // tries to reach a mail server that is not there, and no notification is lost
  // either.

  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:8081",
      "http://localhost:5166",
      "https://localhost:7191"
    ]
  }
}
