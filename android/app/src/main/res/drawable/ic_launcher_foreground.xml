<?xml version="1.0" encoding="utf-8"?>
<!--
    The foundation's mark: a sheltering arc over an open book. Drawn as a
    vector so one file covers every density, and kept to two shapes so it is
    still legible at 48dp on a cheap phone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:translateX="0" android:translateY="0">
        <!-- The arc: shelter, and the foundation's "walking alongside". -->
        <path
            android:pathData="M30,46 C30,32 39,24 54,24 C69,24 78,32 78,46"
            android:strokeColor="#C2A870"
            android:strokeWidth="5.5"
            android:strokeLineCap="round" />

        <!-- The open book. -->
        <path
            android:pathData="M30,54 L52,59 L52,82 L30,77 Z"
            android:fillColor="#FAF6EE" />
        <path
            android:pathData="M78,54 L56,59 L56,82 L78,77 Z"
            android:fillColor="#EDE5D6" />
    </group>
</vector>
