<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <com.google.android.material.card.MaterialCardView
        style="@style/TheeBuhle.Card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="7dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/attendanceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/forest"
                android:textSize="30sp"
                tools:text="100%" />

            <TextView
                style="@style/TheeBuhle.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_attendance" />

            <TextView
                android:id="@+id/attendanceNote"
                style="@style/TheeBuhle.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                tools:text="12 of 12 sessions" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/TheeBuhle.Card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="7dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/badgesValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/gold"
                android:textSize="30sp"
                tools:text="5" />

            <TextView
                style="@style/TheeBuhle.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_badges" />

            <TextView
                android:id="@+id/subjectNote"
                style="@style/TheeBuhle.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                tools:text="Mathematics +29.0" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
