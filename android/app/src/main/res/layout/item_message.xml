<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/TheeBuhle.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/messageCategory"
                style="@style/TheeBuhle.Eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="PROGRAMME UPDATE" />

            <TextView
                android:id="@+id/messageUnread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/gold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/home_new"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/messageTitle"
            style="@style/TheeBuhle.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="19sp"
            tools:text="Term 3 sessions move to Room B" />

        <TextView
            android:id="@+id/messageBody"
            style="@style/TheeBuhle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Same time, same building — just one floor up." />

        <TextView
            android:id="@+id/messageMeta"
            style="@style/TheeBuhle.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            tools:text="Lerato Khumalo · 20 Sep 2026" />

        <TextView
            android:id="@+id/messageAction"
            style="@style/TheeBuhle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/mist"
            android:padding="10dp"
            android:textColor="@color/gold_d"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Please answer by 30 Sep 2026"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
