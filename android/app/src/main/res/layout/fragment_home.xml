<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stateHost"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- The greeting band, in ink like the website's hero. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ink"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="26dp">

                    <TextView
                        android:id="@+id/roleLabel"
                        style="@style/TheeBuhle.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Parent or guardian" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/greeting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:textColor="@color/cream"
                            android:textSize="28sp"
                            tools:text="Nomvula Mahlangu" />

                        <!--
                            Sign out belongs on the screen rather than behind a
                            menu: a Saturday session runs on shared devices, and
                            the next person to pick up the phone must not
                            inherit somebody's session.
                        -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/signOutButton"
                            style="@style/TheeBuhle.Button.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sign_out"
                            android:textColor="@color/gold_soft"
                            app:strokeColor="@color/ink_40" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/childrenScroller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:scrollbars="none"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/childrenChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true"
                            app:singleSelection="true" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="28dp" />
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/view_state" />
</FrameLayout>
